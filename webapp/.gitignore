# 파일 무시 규칙에 대해 더 알고 싶으면: https://help.github.com/articles/ignoring-files/

# 의존성
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 테스트
/coverage

# next.js
/.next/
/out/

# 프로덕션
/build

# 기타
.DS_Store
*.pem

# 디버그
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 환경변수 파일. 실제 값이 든 .env는 절대 커밋하지 않는다.
# 단 .env.example은 어떤 변수를 채워야 하는지 알려주는 템플릿이라 예외로 포함한다.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/generated/prisma
