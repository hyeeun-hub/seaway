# Postgres 연결 문자열. 로컬 개발은 `npx create-db@latest --env .env`로 즉시 발급받을 수 있음
# (24시간 뒤 자동 삭제되는 임시 DB. claimUrl로 claim하면 영구 보존).
# 배포 시에는 claim한 DB 또는 Neon 등 별도 Postgres의 연결 문자열을 넣는다.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# 챗봇용 Gemini API 키. 서버(app/api/chat)에서만 사용하며 클라이언트에 노출되지 않는다.
# 비워두면 챗봇 입력창이 비활성화된 채로 나머지 대시보드는 정상 동작한다.
GEMINI_API_KEY=

# 선택. 기본값은 gemini-flash-latest(항상 현재 권장 flash 모델을 가리키는 별칭).
# 특정 버전에 고정하고 싶을 때만 설정한다.
GEMINI_MODEL=

# 배포본을 링크 받은 사람만 열람하게 하는 공유 비밀번호(proxy.ts).
# 값을 넣으면 브라우저 기본 인증 팝업이 뜨고, 아이디는 아무거나 비밀번호만 일치하면 통과한다.
# 비워두면 관문이 열린 상태가 된다 — 로컬 개발에서는 비워두고, 배포 환경에만 설정한다.
SITE_PASSWORD=

